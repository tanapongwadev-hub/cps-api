# Application
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=9203106
DB_DATABASE=cps_database
DB_SCHEMA=iam
DB_SYNCHRONIZE=false

# JWT Configuration
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_DEPARTMENT_SELECTION_SECRET=replace-with-a-third-long-random-secret
JWT_DEPARTMENT_SELECTION_EXPIRES_IN=5m

# Security Configuration
PASSWORD_HASH_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=false

# Initial Super Admin
INITIAL_SUPER_ADMIN_USERNAME=superadmin
INITIAL_SUPER_ADMIN_PASSWORD=replace-with-a-one-time-secret
INITIAL_SUPER_ADMIN_FIRST_NAME=System
INITIAL_SUPER_ADMIN_LAST_NAME=Administrator
INITIAL_SUPER_ADMIN_EMAIL=superadmin@example.com
